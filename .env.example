# Copy to .env for running on your own PC (never upload .env to GitHub)
GEMINI_API_KEY=            # your Gemini key (AI Studio "AIza..." or Vertex express "AQ..." both work)
# OPENAI_API_KEY=          # optional paid fallback, used only with ALLOW_PAID_AI=1
CHANNEL_NAME=Secret
VIDEOS_PER_RUN=1
TTS_VOICE=en-US-AndrewMultilingualNeural
USE_WEB_RESEARCH=0         # 1 = Gemini + Google Search fact-finding before each script (small free quota)
UPLOAD_MODE=manual         # api only after YouTube approves your API audit
YT_PRIVACY=unlisted
# NTFY_TOPIC=              # phone notifications via the free ntfy app
# FAST_RENDER=1            # quicker, lower-quality renders for testing
